{
  "name": "ruderbar-e2etests",
  "version": "1.0.0",
  "description": "E2E and API tests for Ruderbar POS system",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api-tests",
    "test:admin": "playwright test --project=admin-chromium",
    "test:terminal": "playwright test --project=terminal-touch",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
