{
  "name": "clubbar-e2etests",
  "version": "1.0.0",
  "description": "E2E and API tests for Club Bar POS system",
  "scripts": {
    "test": "playwright test --workers 4 --project=api-tests --project=admin-chromium --project=admin-mobile --project=terminal-touch",
    "test:api": "playwright test --project=api-tests",
    "test:admin": "playwright test --project=admin-chromium",
    "test:terminal": "playwright test --project=terminal-touch",
    "test:rate-limit": "playwright test --project=rate-limit --workers=1",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "walkthrough": "playwright test --project=walkthrough --workers=1",
    "walkthrough:screenshots": "playwright test --project=walkthrough-screenshots --workers=1",
    "lint": "eslint .",
    "test:lint-rules": "node --test eslint-rules/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0"
  }
}
