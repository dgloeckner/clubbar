{
  "name": "clubbar-e2etests",
  "version": "1.0.0",
  "description": "E2E and API tests for Club Bar POS system",
  "scripts": {
    "test": "playwright test --workers 4 --project=api-tests --project=api-ordered --project=api-rotation --project=admin-chromium --project=admin-mobile --project=terminal-touch --project=mail-chain",
    "test:mail": "playwright test --project=mail-chain",
    "test:api": "playwright test --project=api-tests --project=api-ordered --project=api-rotation",
    "test:admin": "playwright test --project=admin-chromium",
    "test:terminal": "playwright test --project=terminal-touch",
    "test:rate-limit": "playwright test --project=rate-limit --workers=1",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "walkthrough": "playwright test --project=walkthrough --workers=1",
    "walkthrough:screenshots": "playwright test --project=walkthrough-screenshots --workers=1",
    "lint": "eslint .",
    "test:lint-rules": "node --test eslint-rules/*.test.js scripts/*.test.mjs",
    "check:ci-lanes": "node scripts/check-ci-lanes.mjs",
    "check:dependabot-groups": "node scripts/check-dependabot-groups.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
