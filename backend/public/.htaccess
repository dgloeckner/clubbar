RewriteEngine On

# Pass Authorization header to PHP (stripped by Apache mod_headers/CGI by default)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Block dotfiles
RedirectMatch 403 /\.(.*)$

# install.php (the dev-only migration/seed tool, distinct from the packaged
# release wizard at package/install.php) is not blocked at the .htaccess
# layer here (#884): scripts/dev-setup.sh drives it over HTTP with
# X-Install-Key on every fresh clone and CI run, so an always-on deny would
# have to be commented out and restored by hand for that to keep working —
# exactly the manual step dev-setup.sh exists to avoid. Its own auth is what
# actually gates it: a timing-safe INSTALL_KEY comparison, and a
# storage/.installed marker that refuses every action once migrations have
# run once (see backend/public/install.php).

# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Security headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
