# Development Dockerfile for serversideup/php
# Matches host user UID/GID to prevent file permission issues on macOS/Linux
#
# Build with:
#   docker compose up -d
# (requires UID and GID build args passed via docker-compose.yml)

FROM serversideup/php:8.3-fpm-apache-bookworm as development

# Build arguments for host user matching (default: 1000:1000)
ARG USER_ID=1000
ARG GROUP_ID=1000

# Change www-data UID/GID to match host user
# This allows seamless file editing between host and container
USER root

RUN docker-php-serversideup-set-id www-data ${USER_ID}:${GROUP_ID} && \
    docker-php-serversideup-set-file-permissions --owner ${USER_ID}:${GROUP_ID}

USER www-data

# Production stage - uses secure defaults (UID 33:GID 33)
FROM serversideup/php:8.3-fpm-apache-bookworm as production
# No changes - uses default secure permissions
