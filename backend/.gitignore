/vendor/
/.env
/logs/*.log
/storage/install.lock
/storage/install.php.disabled
# Uploaded mandate documents are runtime state, and member data at that.
# Every local E2E run leaves a few behind; none of them belong in the repo.
/storage/mandates/*.pdf
# Rendered settlement mails from bin/preview-mails.php. Build output of a
# design check, regenerated in a second; the fixtures that produce it are the
# part worth reviewing, and they live in the script.
/storage/mail-preview/
# Session files, moved here from the host's shared directory by
# RuntimeHardening (#246). Every local run creates them; a session file is a
# login, so none of them belong in the repo.
/storage/sessions/
# The drain's flock file (#403). Created by every cron run and by the URL
# trigger; the pid inside it is meaningless to anyone but the run that wrote it.
/storage/mail-drain.lock
# The backup's own flock file (ADR-0049, #690). Its own file rather than the
# drain's, so the two scheduled jobs cannot block each other — which is the
# thing separating them was for.
/storage/backup.lock
*.php.disabled
.DS_Store
Thumbs.db
.phpunit.result.cache
.phpunit.cache/
/coverage/
/VERSION
