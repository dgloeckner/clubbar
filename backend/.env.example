APP_ENV=production
# Never enable in production — exposes stack traces in API error responses
APP_DEBUG=false
APP_URL=http://localhost:8080

# The zone the club reads in — one clock for the whole of the club's books.
# Timestamps are stored and served in UTC; this is the zone every surface
# converts them back into: the admin panel (which reads it from
# GET /api/instance-config), the mails, the CSV exports, and the day, week and
# hour buckets behind the dashboard and the reports. An IANA name; an unknown
# one falls back to Europe/Berlin rather than failing a send — and the admin
# dashboard says so, because a club on the wrong clock cannot see it anywhere
# else.
# See backend/patterns/pattern-020-club-timezone-rendering.md.
# CLUB_TIMEZONE=Europe/Berlin

DB_HOST=database
DB_PORT=3306
DB_NAME=clubbar
DB_USER=clubbar
DB_PASS=

SESSION_MAX_AGE=7200
SESSION_REGEN_INTERVAL=900

# Marks the admin session cookie `Secure`, so the browser never sends it over
# plain HTTP. Leave unset: it is then on whenever APP_URL is an https:// URL or
# the request arrived over TLS, and off for plain-HTTP local development.
# Set it explicitly only to force the derivation one way (a Secure cookie is
# dropped by the browser over HTTP, so "true" on an HTTP host breaks login).
# SESSION_COOKIE_SECURE=true

# Lifetime of a terminal API token, in days. A token stops authenticating this
# long after it was issued; an admin reissues one with the terminal's
# "rotate token" action, which stages a replacement alongside the current one
# (#395). A value below 1 is ignored and the default applies — expiry cannot be
# switched off.
#
# 365 days is the shared credential cryptoperiod (ADR-0036), the same one the
# IBAN encryption keys carry, warned about on the same 90/30/7 tiers.
API_TOKEN_TTL_DAYS=365

# Set to "true" in test/CI environments to prevent terminal API rate limiting from
# blocking parallel E2E tests. Never set in production.
DISABLE_TERMINAL_RATE_LIMITING=false

# Same, for the admin login and MFA endpoints (5 failed attempts / 15 min, counted
# per IP and per account). Never set in production — it is the only thing bounding
# TOTP guessing.
DISABLE_LOGIN_RATE_LIMITING=false

# Comma-separated list of allowed frontend origins. Never use * in production.
# Example: CORS_ORIGINS=https://admin.your-club.de,https://terminal.your-club.de
CORS_ORIGINS=http://localhost:5173
INSTALL_KEY=

# 32-byte hex key for AES-256-CBC encryption of TOTP secrets at rest.
# REQUIRED — generate your own before starting the backend:
#   openssl rand -hex 32
# Leave it empty and every admin login fails rather than the backend encrypting
# secrets under a key it cannot vouch for. Do not copy a key out of this
# repository either: the fixed development key lives in docker-compose.yml
# (APP_ENV=local), where seed.sql's pre-encrypted test admin needs it, and the
# backend rejects that key under any other APP_ENV precisely because it is public.
TOTP_ENCRYPTION_KEY=

# Outgoing mail (ADR-0038) — one DSN selects the transport.
# Leave unset to disable sending; nothing is sent and the self-check says so.
#   smtp://user:pass@mail.example.org:587   the club's own mailbox
#   native://default                        the host's local MTA
#   null://null                             configured, and deliberately discards
# MAIL_DSN=

# How much one drain run does. Defaults: 25 messages per round, 50 seconds of
# wall clock. Lower the budget where the host cuts a request off sooner.
# MAIL_DRAIN_BATCH_SIZE=25
# MAIL_DRAIN_BUDGET_SECONDS=50

# Authorises the URL drain trigger — only needed on hosting with no CLI cron
# (ADR-0038 rule 3). Unset leaves /api/cron/drain unmounted.
#   curl -sS -H 'X-Cron-Secret: <secret>' https://example.com/api/cron/drain
# Generate with: openssl rand -hex 32
#
# This is the file-editing-only origin of the secret. Settings → Mail in the
# admin panel can also rotate one (#473) — once that has happened, the
# rotated value is the only one accepted and this one stops mattering.
# CRON_SECRET=

# Terminal credential anomaly detection (ADR-0041). The cron tick asks whether
# one terminal token is being used by two devices, and alerts an admin — it
# never blocks, revokes or rate-limits, so these only tune how loud it is.
#
#   LOOKBACK_MINUTES     how far back a scan looks. Wider than any sensible cron
#                        interval, so a late or skipped tick leaves no blind spot.
#   MIN_OVERLAP_MINUTES  how long two addresses must be active *at the same time*
#                        to count as concurrent use. An ISP reconnect hands over
#                        cleanly and overlaps by ~0; lower this and a daily
#                        forced re-dial starts raising alarms.
#   RETENTION_DAYS       how long a source IP is kept before it is pruned.
#   DUAL_STACK_MAX_      how much traffic an IPv4 address and an IPv6 network
#   REQUESTS_PER_HOUR    may carry between them and still count as one
#                        dual-stack terminal rather than two devices. One
#                        terminal is one 60-second polling loop (180-300
#                        requests an hour) however many address families it
#                        speaks; a second device adds a loop and roughly
#                        doubles that. Only ever applied when the window holds
#                        exactly one address of each family — a third source is
#                        not explained by dual-stack and always alerts.
# TERMINAL_ANOMALY_LOOKBACK_MINUTES=60
# TERMINAL_ANOMALY_MIN_OVERLAP_MINUTES=15
# TERMINAL_IP_RETENTION_DAYS=30
# TERMINAL_ANOMALY_DUAL_STACK_MAX_REQUESTS_PER_HOUR=480
