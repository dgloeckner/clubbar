{
    "name": "frgs/clubbar-backend",
    "description": "Club Bar POS Backend - Slim 4",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.3",
        "ext-fileinfo": "*",
        "chillerlan/php-qrcode": "^6.0",
        "digitick/sepa-xml": "^3.1",
        "dompdf/dompdf": "^2.0",
        "league/openapi-psr7-validator": "^0.22.0",
        "robthree/twofactorauth": "^3.0",
        "slim/psr7": "^1.0",
        "slim/slim": "^4.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Db\\": "db/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml --no-coverage",
        "test:coverage": "scripts/coverage.sh",
        "check-coverage": "php scripts/check-coverage.php coverage/clover.xml"
    },
    "scripts-descriptions": {
        "test": "Run the unit + feature suites without coverage (fast).",
        "test:coverage": "Run the suite with pcov in the backend container, enforce the floor, and list the least-covered files. Run from the host.",
        "check-coverage": "Enforce a floor against an existing coverage/clover.xml; pass the percentage as an argument."
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.30"
        }
    }
}
