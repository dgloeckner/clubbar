{
    "name": "frgs/ruderbar-backend",
    "description": "Ruderbar POS Backend - Slim 4",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.3",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.0",
        "digitick/sepa-xml": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Db\\": "db/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
