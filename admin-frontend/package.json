{
  "name": "clubbar-admin-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:timezones": "TZ=America/Los_Angeles vitest run && TZ=Europe/Berlin vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "generate": "orval",
    "postinstall": "orval"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "i18next": "^26.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "orval": "8.49.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "@scalar/json-magic": {
      "undici": "^7.30.1"
    }
  }
}
