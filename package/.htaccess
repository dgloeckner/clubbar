# IONOS (the reference target, ADR-0031) runs PHP as CGI/FPM, not mod_php. A
# bare `php_value` or `php_flag` here is not a no-op on that SAPI — Apache
# returns HTTP 500 for the whole request, an outage indistinguishable from an
# application bug. Do not add either directive unqualified; wrap it in
# <IfModule mod_php.c> or, better, set it from PHP_INI_PERDIR in .user.ini or
# from code in RuntimeHardening.php (#246). See ADR-0031 decision 5.

Options -MultiViews -Indexes

# Block direct HTTP access to the install key file
<Files ".installer-data">
    Require all denied
</Files>

<Files ".upgrade-secret">
    Require all denied
</Files>

# Names the directory holding config.php, the scanned mandates and the logs.
# It is a .php file precisely so that a host ignoring this denial executes it
# instead of printing the path (#245) — this block is the belt, not the braces.
<Files "data-path.php">
    Require all denied
</Files>

# Deny config.php (database password and the TOTP encryption key), *.log, *.sql
# and package.json — none of these should ever be served as source, but a host
# that stops executing PHP (a misconfigured handler after a PHP version change
# is the classic way this happens) would otherwise hand config.php out verbatim
# (#249).
#
# `config.sample.php` is matched too. Since #751 the package ships it inside
# `backend/`, which the rewrite below denies wholesale — this is what still
# answers for a copy an operator unpacked from an older release, or put back by
# hand next to index.php.
<FilesMatch "(^config(\.sample)?\.php$|\.(log|sql)$|^package\.json$)">
    Require all denied
</FilesMatch>

# Deny every dotfile beyond the ones already named above — .user.ini,
# .htaccess itself, and any stray .env/.git/.DS_Store a host or a careless
# upload leaves behind.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

# Apache/CGI/FPM (IONOS's SAPI, ADR-0031) strips the Authorization header
# before PHP ever sees it — TerminalTokenAuth reads it via PSR-7 and 401s
# with "authorization_header_missing" even when the client sent it correctly.
# Restore it into the CGI environment so getHeaderLine('Authorization') works.
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Force HTTPS in production (skip on localhost for dev/CI)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block direct access to backend internals (source, vendor, storage, logs)
RewriteRule ^backend/ - [F,L]

# Block direct access to the offline-only backup tools (#733). Both pages are
# meant to be opened from a local copy (file://), never fetched from the
# server they exist to protect — a compromised host could otherwise serve a
# modified keypair generator that steals the private half it just displayed.
# They also do not work when served: script-src 'self' with no unsafe-inline
# (below) refuses their inline <script>, so the buttons would look present
# and do nothing. Shipped in the release ZIP regardless — see
# scripts/build-package.sh — for opening locally.
RewriteRule ^tools/ - [F,L]

# The public self-registration page (ADR-0052 decision 11, #781). It is a
# *directory* holding index.html, so the `-f` check below never matches
# `/register` or `/register/` and the front controller would answer with the
# admin SPA — a member scanning the club's QR poster lands on a login form
# (#796). Its own assets (register.css, register.js) are real files and are
# served by the `-f` rule as they always were.
#
# Rewritten rather than left to mod_dir: mod_rewrite in .htaccess runs during
# the fixup phase, before DirectoryIndex ever sees the request.
#
# **The slash is redirected, not rewritten** (#812), and that difference is the
# whole reason this is two rules. `PosterSecret::PATH` is `/register` without
# one, so the QR code on the clubhouse wall sends every member to the slashless
# form. An internal rewrite leaves the browser's URL at `/register`, and the
# page's own `./register.css` and `./register.js` then resolve as *siblings* of
# it — `/register.css`, which is not a file, so the front controller answers
# with the admin SPA's HTML: a stylesheet and a script that are 200 OK, of the
# wrong type, and inert. The form renders unstyled and does nothing.
#
# Taking over the path is what removed the redirect: mod_dir issues exactly
# this 301 for a directory, which is why the docker layout — where the document
# root *is* `backend/public` and no rule claims `/register` — never showed it.
# So the rule that claims the path also has to do mod_dir's job. The fragment
# carrying the poster secret survives: a browser re-attaches it to a redirect
# target that has none of its own.
RewriteRule ^register$ /register/ [R=301,L]
RewriteRule ^register/$ register/index.html [L]

# If the file exists on disk, serve it directly (SPA assets, install.php)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Everything else → front controller (handles API routing, SPA fallback,
# and redirect to install.php when not yet configured)
RewriteRule ^ index.php [L,QSA]

# Ensure correct MIME types for static assets
<IfModule mod_mime.c>
    AddType image/svg+xml .svg .svgz
</IfModule>

# Security headers
<IfModule mod_headers.c>
    # Strict-Transport-Security: belt for RuntimeHardening::applySecurityHeaders()
    # (#383, ADR-0031 — CSP and HSTS moved to L0). `Header set` overwrites rather
    # than duplicates a header PHP already sent, so this line is redundant on a
    # host that honours .htaccess and the only source on one that does not.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # expose_php is PHP_INI_SYSTEM and unreachable from a shipped file on mass
    # hosting (ADR-0031); RuntimeHardening::apply() already strips this header
    # from code (#246), this is the belt for a request that never reaches it.
    Header always unset X-Powered-By

    # Content-Security-Policy (#250; #383, ADR-0031 — CSP and HSTS moved to L0).
    # Belt for RuntimeHardening::applySecurityHeaders(): redundant on a host
    # that honours .htaccess, the only source on one that does not. Keep this
    # value identical to RuntimeHardening's CSP_HEADER constant by hand.
    #
    # The Vite build ships no third-party origins and no inline <script>, so
    # script-src is 'self' with neither unsafe-inline nor unsafe-eval.
    #
    # style-src keeps 'unsafe-inline': the admin panel computes its design-system
    # theme in TypeScript and injects it as a <style> element at startup, and
    # several components render scoped @keyframes the same way. React's inline
    # `style={{...}}` attributes — used throughout for dynamic, per-render values
    # (widths, colors from the theme) — are covered by the same directive and
    # cannot be nonced or hashed: a nonce only applies to <style> elements, not
    # to the style="" attribute, and a hash-source is not workable for values
    # computed at render time. Eliminating this would mean rewriting every
    # dynamic inline style in the panel to a CSS class, which is out of scope
    # here; the risk is first-party CSS only, not attacker-controlled markup.
    #
    # worker-src carries blob: because the mandate upload flow (heic2any for
    # iPhone photos, browser-image-compression before submitting a scan) spins
    # up its worker from a Blob URL rather than a same-origin script file —
    # confirmed against the built package, not assumed from the library docs.
    #
    # img-src carries data: for the TOTP enrollment QR code, returned by the
    # API as a data: URI and rendered directly in an <img>.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
#
# A year is right for what the SPA ships, because Vite writes the content hash
# into every filename: `assets/index-Bx3k9f.js` is a different URL the moment
# its bytes differ, so a cached copy can never be the wrong one.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# …but the onboarding page is hand-written, and its two assets have stable
# names (#812).
#
# `register/register.css` and `register/register.js` carry no hash — the page
# has no build step on purpose, so that a club can change a sentence without a
# toolchain. Under the rule above, a phone that has once opened `/register`
# keeps that release's stylesheet for a year: an upgrade replaces `index.html`
# (HTML gets no expiry here, so it revalidates) and the new markup is styled by
# the old file. The club's masthead and colophon then render as unstyled text
# flush to the edge of the screen, in the palette of whichever release that
# phone saw first — and the club, which upgraded weeks ago, sees the correct
# page from its own browser.
#
# The build stamps each reference with the asset's content hash
# (`build-package.sh`), which is what actually breaks an already-cached copy.
# This block is the belt: if that stamp is ever lost, the cost is one
# revalidation per page load instead of a year of a broken form.
#
# `<FilesMatch>` applies to this directory and everything below it, and the two
# names are distinctive enough that nothing else in the tree matches.
<FilesMatch "^register\.(css|js)$">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
        Header unset Expires
    </IfModule>
</FilesMatch>
