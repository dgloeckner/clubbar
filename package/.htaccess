# IONOS (the reference target, ADR-0031) runs PHP as CGI/FPM, not mod_php. A
# bare `php_value` or `php_flag` here is not a no-op on that SAPI — Apache
# returns HTTP 500 for the whole request, an outage indistinguishable from an
# application bug. Do not add either directive unqualified; wrap it in
# <IfModule mod_php.c> or, better, set it from PHP_INI_PERDIR in .user.ini or
# from code in RuntimeHardening.php (#246). See ADR-0031 decision 5.

Options -MultiViews -Indexes

# Block direct HTTP access to the install key file
<Files ".installer-data">
    Require all denied
</Files>

<Files ".upgrade-secret">
    Require all denied
</Files>

# Names the directory holding config.php, the scanned mandates and the logs.
# It is a .php file precisely so that a host ignoring this denial executes it
# instead of printing the path (#245) — this block is the belt, not the braces.
<Files "data-path.php">
    Require all denied
</Files>

# Deny config.php / config.sample.php (database password and the TOTP
# encryption key), *.log, *.sql and package.json — none of these should ever
# be served as source, but a host that stops executing PHP (a misconfigured
# handler after a PHP version change is the classic way this happens) would
# otherwise hand config.php out verbatim (#249).
<FilesMatch "(^config(\.sample)?\.php$|\.(log|sql)$|^package\.json$)">
    Require all denied
</FilesMatch>

# Deny every dotfile beyond the ones already named above — .user.ini,
# .htaccess itself, and any stray .env/.git/.DS_Store a host or a careless
# upload leaves behind.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

# Force HTTPS in production (skip on localhost for dev/CI)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block direct access to backend internals (source, vendor, storage, logs)
RewriteRule ^backend/ - [F,L]

# If the file exists on disk, serve it directly (SPA assets, install.php)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Everything else → front controller (handles API routing, SPA fallback,
# and redirect to install.php when not yet configured)
RewriteRule ^ index.php [L,QSA]

# Ensure correct MIME types for static assets
<IfModule mod_mime.c>
    AddType image/svg+xml .svg .svgz
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # expose_php is PHP_INI_SYSTEM and unreachable from a shipped file on mass
    # hosting (ADR-0031); RuntimeHardening::apply() already strips this header
    # from code (#246), this is the belt for a request that never reaches it.
    Header always unset X-Powered-By
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
